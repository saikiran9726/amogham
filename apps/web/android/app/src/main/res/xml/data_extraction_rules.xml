<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Restaurant OS Data Extraction Rules (Android 12+).
      Disables cloud and device-to-device migration of sensitive tokens and cached receipts.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
